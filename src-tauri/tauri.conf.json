{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchedFlow",
  "version": "0.1.0",
  "identifier": "com.schedflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "日程通",
        "width": 1180,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "float",
        "title": "",
        "width": 64,
        "height": 64,
        "resizable": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
